  "event": [
    {
      "listen": "test",
      "script": {
        "exec": [
          "// Reusable shipment validation function\r",
          "function validateShipment(shipment) {\r",
          "    const requiredFields = [\r",
          "        \"id\",\r",
          "        \"merchantId\",\r",
          "        \"recipientName\",\r",
          "        \"city\",\r",
          "        \"weightKg\",\r",
          "        \"service\",\r",
          "        \"feePhp\",\r",
          "        \"status\",\r",
          "        \"courierId\",\r",
          "        \"createdAt\",\r",
          "        \"updatedAt\"\r",
          "    ];\r",
          "\r",
          "    requiredFields.forEach((field) => {\r",
          "        pm.expect(shipment).to.have.property(field);\r",
          "    });\r",
          "\r",
          "    // Validate allowed shipment statuses\r",
          "    const allowedStatuses = [\r",
          "        \"Created\",\r",
          "        \"PickedUp\",\r",
          "        \"InTransit\",\r",
          "        \"Delivered\",\r",
          "        \"Returned\",\r",
          "        \"Cancelled\"\r",
          "    ];\r",
          "\r",
          "    pm.expect(shipment.status).to.be.oneOf(allowedStatuses);\r",
          "\r",
          "    // Validate Standard shipment fee\r",
          "    if (shipment.service === \"Standard\") {\r",
          "        const surcharge = Math.ceil(\r",
          "            Math.max(0, shipment.weightKg - 10)\r",
          "        ) * 15;\r",
          "\r",
          "        pm.expect(shipment.feePhp).to.equal(120 + surcharge);\r",
          "    }\r",
          "}\r",
          "\r",
          "// Apply validation to shipment requests only\r",
          "const shipmentRequests = [\r",
          "    \"GET Shipments\",\r",
          "    \"GET Shipment/ID\",\r",
          "    \"Add Shipment\",\r",
          "    \"Change Status\"\r",
          "];\r",
          "\r",
          "if (shipmentRequests.includes(pm.info.requestName)) {\r",
          "    pm.test(\"Validate Shipment Fields and Values\", function () {\r",
          "        const data = pm.response.json();\r",
          "\r",
          "        if (pm.info.requestName === \"GET Shipments\") {\r",
          "            pm.expect(data.items).to.be.an(\"array\");\r",
          "\r",
          "            data.items.forEach((shipment) => {\r",
          "                validateShipment(shipment);\r",
          "            });\r",
          "        } else {\r",
          "            validateShipment(data);\r",
          "        }\r",
          "    });\r",
          "}"
        ],
        "type": "text/javascript"
      }
    }
