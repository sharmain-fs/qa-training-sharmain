      "name": "Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Clear any previously stored token\r\npm.environment.unset(\"token\");\r\n\r\npm.test(\"Login OK\", function () {\r\n    pm.response.to.have.status(200);\r\n\r\n    const json = pm.response.json();\r\n    pm.expect(json.token).to.be.a(\"string\");\r\n    pm.expect(json.token).to.not.be.empty;\r\n\r\n    // Save the token only after validation passes\r\n    pm.environment.set(\"token\", json.token);\r\n});"
            ]
          }
        }
      ],
