      "name": "Add Shipment",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 201\", function () {\r\n    pm.response.to.have.status(201);\r\n});\r\n\r\npm.test(\"Check Created Shipment\", function () {\r\n    const data = pm.response.json();\r\n    const requestBody = JSON.parse(\r\n        pm.variables.replaceIn(pm.request.body.raw)\r\n    );\r\n\r\n    pm.expect(data.recipientName).to.equal(requestBody.recipientName);\r\n    pm.expect(data.city).to.equal(requestBody.city);\r\n    pm.expect(data.weightKg).to.equal(requestBody.weightKg);\r\n    pm.expect(data.service).to.equal(requestBody.service);\r\n    pm.expect(data.status).to.equal(\"Created\");\r\n});\r\n\r\npm.test(\"Response time is less than 200ms\", function () {\r\n    pm.expect(pm.response.responseTime).to.be.below(200);\r\n});"
            ]
          }
        }
